{
  "name": "agency-commons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4", "npm": ">=9.6.5" },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "ready": "node scripts/ready.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run ready && npm run build && wrangler deploy"
  },
  "dependencies": { "astro": "7.4.3" },
  "devDependencies": { "wrangler": "4.154.0" }
}
