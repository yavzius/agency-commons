{
  "name": "agency-commons-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "doctor": "node scripts/doctor.ts",
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/check-build.ts",
    "preview": "astro preview --host 127.0.0.1",
    "ready": "node scripts/ready.ts",
    "test": "node --test tests/*.test.ts",
    "deploy": "npm run check && npm test && npm run ready && npm run build && wrangler deploy",
    "check": "astro check"
  },
  "dependencies": {
    "astro": "7.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "wrangler": "4.154.0"
  }
}
