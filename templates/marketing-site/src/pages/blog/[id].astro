---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { visiblePosts, isPublished } from '../../lib/blog.mjs';

export async function getStaticPaths() {
  return visiblePosts(await getCollection('blog'), { preview: import.meta.env.DEV })
    .map(post => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const unpublished = !isPublished(post);
const formatDate = date => new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' }).format(date);
---
<ArticleLayout title={post.data.title} description={post.data.description} noindex={import.meta.env.DEV || unpublished} article>
  {unpublished && <p class="draft-notice">Unpublished preview · this post will not appear in a production build.</p>}
  <article>
    <p class="eyebrow"><a href="/blog/">The journal</a></p>
    <h1>{post.data.title}</h1>
    <p class="post-meta">{post.data.author && <span>By {post.data.author} · </span>}<time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
      {post.data.updatedAt && <span> · Updated <time datetime={post.data.updatedAt.toISOString()}>{formatDate(post.data.updatedAt)}</time></span>}
    </p>
    <p class="intro">{post.data.description}</p>
    <div class="prose"><Content /></div>
  </article>
</ArticleLayout>
