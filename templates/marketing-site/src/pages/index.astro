---
import { site } from '../site.config.mjs';
import { getCollection } from 'astro:content';
import { visiblePosts } from '../lib/blog.mjs';
import '../styles/global.css';
import ActionLink from '../components/ActionLink.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Disclosure from '../components/Disclosure.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hero from '../components/Hero.astro';
const emailHref = site.contactEmail ? `mailto:${site.contactEmail}` : null;
const hasPosts = visiblePosts(await getCollection('blog'), { preview: import.meta.env.DEV }).length > 0;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.businessName} — {site.headline}</title>
    <meta name="description" content={site.description} />
    <meta name="robots" content={site.isDemo || !site.allowIndexing ? 'noindex, nofollow' : 'index, follow'} />
    <meta property="og:title" content={site.businessName} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content="website" />
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}
    {site.url && <link rel="canonical" href={site.url} />}
    {site.url && <meta property="og:url" content={site.url} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {site.isDemo && <aside class="demo-notice">Practice website · {site.businessName} is a fictional business</aside>}
    <SiteHeader home hasPosts={hasPosts} />
    <main id="main">
      <Hero />
      <section id="services" class="section shell" aria-labelledby="services-title">
        <div class="section-heading"><p class="eyebrow">Our approach</p><h2 id="services-title">Good ideas, made practical.</h2></div>
        <div class="cards">
          {site.services.map((service, index) => <ServiceCard {...service} number={index + 1} />)}
        </div>
      </section>
      <section class="process-band" aria-labelledby="process-title">
        <div class="shell section"><div class="section-heading"><p class="eyebrow">Working together</p><h2 id="process-title">A little clarity goes a long way.</h2></div>
          <ol class="steps">{site.process.map(step => <li><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
        </div>
      </section>
      <section class="section shell faq-section" aria-labelledby="faq-title">
        <div><p class="eyebrow">Before we begin</p><h2 id="faq-title">A few useful answers.</h2></div>
        <div class="faq-list">{site.faqs.map(faq => <Disclosure {...faq} />)}</div>
      </section>
      <section id="contact" class="contact shell" aria-labelledby="contact-title">
        <p class="eyebrow">Your next chapter</p><h2 id="contact-title">{site.contactHeading}</h2><p>{site.contactText}</p>
        {emailHref ? <ActionLink href={emailHref}>{site.ctaLabel}</ActionLink> : <p class="contact-placeholder">Demo only — enquiries are not connected yet.</p>}
      </section>
    </main>
    <SiteFooter home />
  </body>
</html>
