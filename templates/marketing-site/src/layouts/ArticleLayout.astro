---
import { site } from '../site.config.ts';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title: string; description: string; noindex?: boolean; article?: boolean; }
const { title, description, noindex = false, article = false } = Astro.props;
const canonical = site.url ? new URL(Astro.url.pathname, site.url).href : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {site.businessName}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex || site.isDemo || !site.allowIndexing ? 'noindex, nofollow' : 'index, follow'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {site.isDemo && <aside class="demo-notice">Practice website · {site.businessName} is a fictional business</aside>}
    <SiteHeader hasPosts />
    <main id="main" class="shell article-shell section"><slot /></main>
    <SiteFooter />
  </body>
</html>
